{
  "id": "org.gtk.Gtk3theme.deepin",
  "branch": "3.22",
  "runtime": "org.freedesktop.Platform",
  "sdk": "org.freedesktop.Sdk",
  "runtime-version": "25.08",
  "build-extension": true,
  "separate-locales": false,
  "modules": [
    {
      "name": "deepin",
      "buildsystem": "simple",
      "build-commands": [
        "install -dm755 /usr/share/runtime/share/themes/deepin/gtk-3.0",
        "cp -aL deepin/gtk-3.0/* /usr/share/runtime/share/themes/deepin/gtk-3.0",
        "cp -a deepin/index.theme /usr/share/runtime/share/themes/deepin"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/linuxdeepin/deepin-gtk-theme/archive/25.3.7.tar.gz",
          "sha256": "77d6862615b726aff533d3f43e6f43e899795c7d7ec0adf0027ee8fc03922c81",
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/linuxdeepin/deepin-gtk-theme/releases/latest",
            "version-query": ".tag_name",
            "url-query": "\"https://github.com/linuxdeepin/deepin-gtk-theme/archive/\" + $version + \".tar.gz\""
          }
        }
      ]
    },
    {
      "name": "appdata",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 org.gtk.Gtk3theme.deepin.appdata.xml ${FLATPAK_DEST}/share/metainfo/org.gtk.Gtk3theme.deepin.metainfo.xml"
      ],
      "sources": [
        {
          "type": "file",
          "path": "org.gtk.Gtk3theme.deepin.appdata.xml"
        }
      ]
    }
  ]
}
